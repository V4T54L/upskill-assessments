# Copy to .env and fill in. .env is gitignored and must stay that way —
# this repository is public.
#
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# The model id you are running against. Record it in every progress entry:
# results are bound to the model that produced them, and free-tier model
# availability changes.
GEMINI_MODEL=

# Hard ceilings your own harness must enforce. These are YOUR numbers, not
# the provider's — the provider rejects you at its limit, your harness should
# stop you before that. Fill them in once you have measured a real run.
MAX_STEPS=
MAX_TOKENS_PER_RUN=
MAX_WALLCLOCK_SECONDS=
