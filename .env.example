# Copy to .env and fill in. .env is gitignored and must stay that way —
# this repository is public.
#
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# The model id you are running against. Record it in every progress entry:
# results are bound to the model that produced them, and free-tier model
# availability changes.
# The minimal client defaults to gemini-flash-latest when this is blank.
GEMINI_MODEL=gemini-3.5-flash-lite

# Hard ceilings your own harness must enforce. These are YOUR numbers, not
# the provider's — the provider rejects you at its limit, your harness should
# stop you before that. Fill them in once you have measured a real run.
# Enforced per designer/builder run. The standalone generate() helper is unbounded.
# Defaults below also apply when these values are blank.
MAX_STEPS=12
MAX_TOKENS_PER_RUN=100000
MAX_WALLCLOCK_SECONDS=300
